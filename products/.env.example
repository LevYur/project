```dotenv
# ===========================================
# Products Service Configuration
# ===========================================

# Окружение
ENV=dev

# ===========================================
# HTTP Server
# ===========================================

HTTP_SERVER_ADDRESS=0.0.0.0:7972
HTTP_SERVER_TIMEOUT=5s
HTTP_SERVER_SHUTDOWN_TIMEOUT=5s
HTTP_SERVER_READ_TIMEOUT=10s
HTTP_SERVER_WRITE_TIMEOUT=10s
HTTP_SERVER_IDLE_TIMEOUT=60s

# ===========================================
# gRPC Server
# ===========================================

RPC_SERVER_HOST=0.0.0.0
RPC_SERVER_PORT=7072
RPC_SERVER_TIMEOUT=5s
RPC_SERVER_SHUTDOWN_TIMEOUT=5s
RPC_SERVER_IDLE_TIMEOUT=60s

# ===========================================
# HTTP Services
# ===========================================

HTTP_GATEWAY_SERVICE_ADDR=http://gateway-service:7970
HTTP_AUTH_SERVICE_ADDR=http://auth-service:7971
HTTP_CART_SERVICE_ADDR=http://cart-service:7974
HTTP_USERS_SERVICE_ADDR=http://users-service:7973
HTTP_ORDERS_SERVICE_ADDR=http://orders-service:7975
HTTP_NOTS_SERVICE_ADDR=http://nots-service:7976

# ===========================================
# gRPC Services
# ===========================================

GRPC_GATEWAY_SERVICE_ADDR=gateway-service:7070
GRPC_AUTH_SERVICE_ADDR=auth-service:7071
GRPC_CART_SERVICE_ADDR=cart-service:7074
GRPC_USERS_SERVICE_ADDR=users-service:7073
GRPC_ORDERS_SERVICE_ADDR=orders-service:7075
GRPC_NOTS_SERVICE_ADDR=nots-service:7076

# ===========================================
# Redis
# ===========================================

REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=3s
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_CACHE_TTL=24h

# ===========================================
# PostgreSQL
# ===========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=products-db
POSTGRES_PORT=5432
POSTGRES_NAME=products
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONN=10
POSTGRES_CONN_TIMEOUT=5s

# ===========================================
# Kafka
# ===========================================

KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC=product-events
KAFKA_GROUP_ID=cart-service-cache-invalidator
KAFKA_PRODUCER_TIMEOUT=10s
```

